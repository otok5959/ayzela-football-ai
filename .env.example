# AyzEla Football AI - Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi doldurun.
# Gerçek .env dosyasını asla GitHub'a veya herkese açık ortama yüklemeyin.

# --- Genel & Maliyet Kontrolü ---
APP_ENV=development
TZ=Europe/Istanbul
FREE_ONLY_MODE=true
ALL_IDDAA_BULLETIN=true
DAILY_MAX_MATCHES=250
LINEUP_CHECK_INTERVAL_MINUTES=30
LOG_LEVEL=INFO

# --- Veritabanı Seçimi ("sqlite" veya "d1") ---
DB_BACKEND=sqlite
SQLITE_DB_PATH=./data/ayzela.db

# --- Telegram Bot (https://t.me/BotFather ve https://t.me/userinfobot) ---
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_ALLOWED_USER_ID=000000000
TELEGRAM_CHAT_ID=000000000
TELEGRAM_WEBHOOK_SECRET=replace_with_strong_random_secret_min_32_chars

# --- Cloudflare D1 & Workers ---
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_DATABASE_ID=replace_with_d1_database_id
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_d1_api_token

# --- Yönetim Paneli Güvenliği ---
ADMIN_SESSION_SECRET=replace_with_random_hex_64_chars
ADMIN_USERNAME=ayzela_admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$100000$replace_salt$replace_hash
PANEL_BASE_URL=https://ayzela-panel.pages.dev

# --- GitHub Actions Tetikleme ---
GITHUB_REPOSITORY=username/ayzela-football-ai
GITHUB_DISPATCH_TOKEN=replace_with_fine_grained_pat_actions_write
